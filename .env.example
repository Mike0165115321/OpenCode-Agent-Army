# DeepSeek API Key — get one at https://platform.deepseek.com
# Required for @coder agent (deepseek/v4-pro)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# @vision uses local Ollama (qwen3-vl:8b) — no API key needed
# Make sure Ollama is running: ollama serve

# ⚠️ Do NOT set OPENAI_API_BASE — it's configured in opencode.json
# If you have it set globally, the config overrides OpenAI's base URL
# to https://api.openai.com to avoid routing through DeepSeek.
