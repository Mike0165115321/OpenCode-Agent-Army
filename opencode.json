{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/north-mini-code-free",
  "instructions": ["CONTEXT.md"],

  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "baseURL": "https://api.deepseek.com"
      }
    },
    "openai": {
      "options": {
        "baseURL": "https://api.openai.com"
      }
    }
  },

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "mcpvault": {
      "type": "local",
      "command": ["npx", "-y", "@bitbonsai/mcpvault@latest", "E:\\MikeData"],
      "enabled": true
    },
    "windows-mcp": {
      "type": "local",
      "command": ["windows-mcp", "serve"],
      "enabled": true
    }
  },

  "agent": {
    "captain": {},
    "vision": { "model": "ollama/qwen3-vl:8b" },
    "desktop": {},
    "browser": {},
    "architect": { "model": "openai/gpt-5.5" },
    "coder": { "model": "deepseek/v4-pro" },
    "reviewer": {},
    "qa": {},
    "director": { "model": "openai/gpt-5.5" },
    "mediaqa": { "model": "ollama/qwen3-vl:8b" }
  },

  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "npm test": "allow",
      "npm run *": "allow",
      "npm install": "allow",
      "npm ci": "allow",
      "npx *": "allow",
      "uv *": "allow",
      "pip install *": "allow",
      "python *": "allow",
      "node *": "allow",
      "git status": "allow",
      "git diff": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push": "ask",
      "git pull": "allow",
      "git fetch": "allow",
      "git branch": "allow",
      "git checkout": "allow",
      "git reset": "deny",
      "git clean": "deny",
      "git merge": "ask",
      "git rebase": "ask",
      "rm *": "ask",
      "Remove-Item *": "ask",
      "del *": "ask"
    }
  }
}
